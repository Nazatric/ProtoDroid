# Prototype port settings. Copy to protore.ini next to the game/ folder
# (Android: /sdcard/Android/data/com.protore.game/files/protore.ini or
#  /storage/emulated/0/Prototype/protore.ini which works on Android 11+ without ADB;
#  desktop: the working directory).
# Any key can also be set as an environment variable PROTORE_<KEY>, e.g. PROTORE_RENDER_HEIGHT=540.
# Supports both flat key = value and [section] headers ([graphics], [audio], etc.)

# Render resolution height; the width follows the screen's aspect ratio and the frame is scaled to the screen.
# 0 = the full window size. Android default 720 (540 for weak GPUs, 900/1080 for flagships).
render_height = 720

# Texture quality: number of top mip levels dropped from large mipmapped textures (>= texture_skip_min_size).
# 0 = original, 1 = half resolution (a quarter of the memory), 2 = quarter resolution. Android default 1.
texture_skip_mips = 1
texture_skip_min_size = 512

# Decode DXT (BC1-3) textures on the CPU. Needed on GPUs without BC formats (Mali, PowerVR) and detected
# automatically; 1/0 forces it on/off.
#decode_dxt = 1

# Maximum texture anisotropy. Android defaults to 1 (linear); Settings offers 1/2/4/8.
# At 1, anisotropic min/mag/mip filters become linear. An explicit d3d9.samplerAnisotropy in DXVK config is preserved.
#max_anisotropy = 1

# Audio backend: aaudio (default) or openslES. Try openslES if the sound stutters while the game runs smoothly.
#audio_driver = openslES
# Reuse the default mastering voice/output thread when the engine recreates its audio voices (Android default 1).
#audio_master_reuse = 1

# Present mode for Mali-G720 MC7 (Xiaomi POCO X7 Pro) crash fix:
# Mali driver crashes with VK_PRESENT_MODE_MAILBOX_KHR (addr 0xb0 NULL deref) during initial
# swapchain recreation (6 -> 7 images). Force FIFO (vsync) on Mali.
# Options: fifo (vsync, stable), mailbox (immediate, lower latency), immediate
# Default: auto (mailbox on Adreno, fifo on Mali when detected via driver)
#present_mode = fifo
#present_fifo = 1
#vsync = 1

# DXVK extra config: d3d9.presentInterval, d3d9.numBackBuffers etc. Comma as separator (semicolon in DXVK).
#dxvk_config = d3d9.presentInterval = 1

# Low-level Mali pipeline diagnostics. Disabled by default because every traced pipeline performs
# SPIR-V analysis plus durable file/fsync writes. Enables pipeline_trace.log and last_vs/last_fs.spv.
# The PROTORE_PIPELINE_TRACE=1 environment variable is an equivalent override.
#pipeline_trace = 1

# Audio mixer and vsync debugging
#present_stats = 1
#fps_limit = 30
#battery_saver = 1
