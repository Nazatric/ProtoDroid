diff --git a/src/dxvk/dxvk_state_cache_io.h b/src/dxvk/dxvk_state_cache_io.h
index f76e16b..c0b1608 100644
--- a/src/dxvk/dxvk_state_cache_io.h
+++ b/src/dxvk/dxvk_state_cache_io.h
@@ -1,9 +1,28 @@
 #pragma once
 
 #include <cstddef>
+#include <string>
 
 namespace dxvk {
 
+  constexpr const char* stateCachePathEnvironmentVariable() {
+    return "DXVK_STATE_CACHE_PATH";
+  }
+
+
+  constexpr const char* androidStateCacheExecutableName() {
+    return "prototypeenginef.dll";
+  }
+
+
+  inline std::string stateCacheFileName(const std::string& directory, const std::string& executableName) {
+    std::string path = directory;
+    if (!path.empty() && path.back() != '/')
+      path += '/';
+    path += executableName + ".dxvk-cache";
+    return path;
+  }
+
   // Keep the cache entry layout and incremental flush in one small, host-testable operation. Android can be killed
   // without running C++ destructors, so buffering an entry until the next one or until shutdown loses useful work.
   template<typename Stream, typename Header, typename Hash>
diff --git a/src/dxvk/dxvk_swapchain_math.h b/src/dxvk/dxvk_swapchain_math.h
new file mode 100644
index 0000000..80d5fc3
--- /dev/null
+++ b/src/dxvk/dxvk_swapchain_math.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <cstdint>
+
+namespace dxvk {
+
+  // Desktop keeps DXVK's historical min+1 preference. Android supplies its desired count directly (three by default)
+  // and both paths clamp to the actual surface limits. A zero maximum means that the surface has no fixed upper bound.
+  constexpr uint32_t pickSwapchainImageCount(uint32_t minImageCount, uint32_t maxImageCount,
+      uint32_t desired, bool desktopExtraImage) {
+    uint32_t count = desired;
+    if (desktopExtraImage && count < minImageCount + 1)
+      count = minImageCount + 1;
+    if (count < minImageCount)
+      count = minImageCount;
+    if (maxImageCount && count > maxImageCount)
+      count = maxImageCount;
+    return count;
+  }
+
+}
