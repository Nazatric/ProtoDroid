+  DxvkPipelineDrainStats DxvkPipelineManager::getWarmCacheStats() {
+    const DxvkPipelineWorkerStats workers = m_workers.getStats();
+    return { m_stateCache.getWorkerPending(), workers.tasksTotal, workers.tasksCompleted };
+  }
