+  DxvkPipelineDrainResult DxvkPipelineManager::waitForWarmCache(uint64_t timeoutNs) {
+    auto result = DxvkPipelineDrain::Wait<std::chrono::steady_clock>(timeoutNs,
+      [] (std::chrono::nanoseconds delay) { std::this_thread::sleep_for(delay); },
+      [this] () { return getWarmCacheStats(); });
+    Logger::info(str::format("DXVK warm-cache drain: ", result.drained ? "drained" : "timeout",
+      " wait=", double(result.waitNs) / 1.0e6, "ms state_pending=", result.stats.stateCachePending,
+      " pipeline_pending=", result.stats.pipelinePending(), " iterations=", result.iterations));
+    return result;
+  }
