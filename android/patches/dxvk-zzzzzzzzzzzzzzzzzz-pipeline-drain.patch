+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+
+namespace dxvk {
+
+  // Snapshot of the two asynchronous stages involved in warm-cache reconstruction. The state-cache feeder can pop
+  // its last item before it enqueues pipeline tasks, so pipeline tasksTotal/tasksCompleted alone are not a drain gate.
+  struct DxvkPipelineDrainStats {
+    uint64_t stateCachePending = 0;
+    uint64_t pipelineTasksTotal = 0;
+    uint64_t pipelineTasksCompleted = 0;
+
+    uint64_t pipelinePending() const {
+      return pipelineTasksTotal > pipelineTasksCompleted
+        ? pipelineTasksTotal - pipelineTasksCompleted : 0;
+    }
+
+    bool idle() const {
+      return stateCachePending == 0 && pipelinePending() == 0;
+    }
+  };
+
+  struct DxvkPipelineDrainResult {
+    DxvkPipelineDrainStats stats;
+    uint64_t waitNs = 0;
+    uint32_t iterations = 0;
+    bool drained = false;
+  };
+
+  // Bounded polling wait for an explicit future loading boundary. This header has no device/Vulkan dependency and
+  // the production caller supplies a sleep outside every device, state-cache and pipeline-worker mutex. There is no
+  // unbounded wait, pipeline creation, shader-variant invention, or implicit call from Present/device destruction.
+  class DxvkPipelineDrain {
+  public:
+    static constexpr uint64_t kMaximumWaitNs = 30000000000ull;
+    static constexpr uint64_t kPollIntervalNs = 1000000ull;
+
+    template<typename Clock, typename Sleep, typename ReadStats>
+    static DxvkPipelineDrainResult Wait(uint64_t timeoutNs, Sleep&& sleep, ReadStats&& readStats) {
+      const uint64_t boundedTimeout = std::min(timeoutNs, kMaximumWaitNs);
+      const auto start = Clock::now();
+      const auto deadline = start + std::chrono::nanoseconds(boundedTimeout);
+      DxvkPipelineDrainResult result;
+
+      while (true) {
+        result.stats = readStats();
+        result.iterations += 1;
+        const auto now = Clock::now();
+        result.waitNs = uint64_t(std::max<int64_t>(0,
+          std::chrono::duration_cast<std::chrono::nanoseconds>(now - start).count()));
+        result.drained = result.stats.idle();
+        if (result.drained || now >= deadline)
+          return result;
+
+        const auto remaining = std::chrono::duration_cast<std::chrono::nanoseconds>(deadline - now);
+        const auto delay = std::min<std::chrono::nanoseconds>(remaining,
+          std::chrono::nanoseconds(kPollIntervalNs));
+        sleep(delay);
+      }
+    }
+  };
+
+}
