+#include "../util/log/log.h"
+#include "../util/util_env.h"
+
+namespace dxvk {
+
+  // Opt-in D3D9 method attribution. Record never logs and is safe to use after acquiring the device mutex;
+  // MaybeLog is called from Present after its lock has been released. Method, lock, prepare and emit times are
+  // inclusive and may be nested, so their totals are attribution signals rather than additive frame-time slices.
+  // State-total changed/flagged fields mean needsUpdate-or-pointer-change/StateBlock recording. Query flagged means
+  // D3DGETDATA_FLUSH, and draw units are issued primitives. Result fields on lock/upload/prepare/emit phases are
+  // not HRESULT evidence; only method totals and query operations have meaningful method results.
+  class D3D9Timing {
+  public:
+
+    enum class Op : uint32_t {
+      DrawLock, DrawTotal, DrawUpload, PrepareDraw, DrawEmit,
+      StreamLock, StreamTotal, IndicesLock, IndicesTotal, TextureLock, TextureTotal,
+      QueryLock, QueryEvent, QueryOcclusion, QueryTimestamp, QueryDisjoint, QueryOther,
+      Count
+    };
+
+    static bool Enabled() {
+      static const bool enabled = env::getEnvVar("PROTODROID_D3D9_TIMING") == "1";
+      return enabled;
+    }
+
+    static int64_t Now() {
+      return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    static void Record(Op op, int64_t durationNs, int32_t result = 0,
+                       bool changed = false, bool flagged = false, uint64_t units = 0) {
+      const uint32_t index = uint32_t(op);
+      if (index >= uint32_t(Op::Count))
+        return;
+      OpStats& stats = Stats()[index];
+      stats.calls.fetch_add(1, std::memory_order_relaxed);
+      const uint64_t duration = uint64_t(std::max(durationNs, int64_t(0)));
+      stats.totalNs.fetch_add(duration, std::memory_order_relaxed);
+      Max(stats.maxNs, duration);
+      if (result == 0)
+        stats.ok.fetch_add(1, std::memory_order_relaxed);
+      else if (result == 1)  // S_FALSE
+        stats.falseResults.fetch_add(1, std::memory_order_relaxed);
+      else
+        stats.errors.fetch_add(1, std::memory_order_relaxed);
+      if (changed)
+        stats.changed.fetch_add(1, std::memory_order_relaxed);
+      if (flagged)
+        stats.flagged.fetch_add(1, std::memory_order_relaxed);
+      if (units)
+        stats.units.fetch_add(units, std::memory_order_relaxed);
+    }
+
+    static void MaybeLog() {
+      if (!Enabled())
+        return;
+      static std::atomic<bool> announced = { false };
+      if (!announced.exchange(true, std::memory_order_relaxed)) {
+        Logger::info("DXVK: D3D9 method timing enabled; inclusive nested phases are non-additive, "
+                     "and these records are not GPU time");
+      }
+      const int64_t now = Now();
+      static std::atomic<int64_t> nextLogNs = { 0 };
+      int64_t next = nextLogNs.load(std::memory_order_relaxed);
+      while (now >= next) {
+        if (nextLogNs.compare_exchange_weak(next, now + 5000000000ll, std::memory_order_relaxed)) {
+          const std::string stats = TakeStats();
+          if (!stats.empty())
+            Logger::info("DXVK D3D9 timing: " + stats);
+          break;
+        }
+      }
+    }
+
+    static void Flush(const char* reason) {
+      if (Enabled())
+        Logger::info("DXVK D3D9 timing final (" + std::string(reason) + "): " + TakeStats());
+    }
+
+  private:
+
+    struct OpStats {
+      std::atomic<uint64_t> calls = { 0 };
+      std::atomic<uint64_t> totalNs = { 0 };
+      std::atomic<uint64_t> maxNs = { 0 };
+      std::atomic<uint64_t> ok = { 0 };
+      std::atomic<uint64_t> falseResults = { 0 };
+      std::atomic<uint64_t> errors = { 0 };
+      std::atomic<uint64_t> changed = { 0 };
+      std::atomic<uint64_t> flagged = { 0 };
+      std::atomic<uint64_t> units = { 0 };
+    };
+
+    struct Snapshot {
+      uint64_t calls = 0;
+      uint64_t totalNs = 0;
+      uint64_t maxNs = 0;
+      uint64_t ok = 0;
+      uint64_t falseResults = 0;
+      uint64_t errors = 0;
+      uint64_t changed = 0;
+      uint64_t flagged = 0;
+      uint64_t units = 0;
+    };
+
+    static std::array<OpStats, uint32_t(Op::Count)>& Stats() {
+      static std::array<OpStats, uint32_t(Op::Count)> stats;
+      return stats;
+    }
+
+    static const char* Name(Op op) {
+      static constexpr const char* names[] = {
+        "draw_lock", "draw_total", "draw_upload", "prepare_draw", "draw_emit",
+        "stream_lock", "stream_total", "indices_lock", "indices_total", "texture_lock", "texture_total",
+        "query_lock", "query_event", "query_occlusion", "query_timestamp", "query_disjoint", "query_other"
+      };
+      return names[uint32_t(op)];
+    }
+
+    static void Max(std::atomic<uint64_t>& target, uint64_t value) {
+      for (uint64_t old = target.load(std::memory_order_relaxed);
+           value > old && !target.compare_exchange_weak(old, value, std::memory_order_relaxed); ) { }
+    }
+
+    static Snapshot Take(OpStats& stats) {
+      Snapshot out;
+      out.calls = stats.calls.exchange(0, std::memory_order_relaxed);
+      out.totalNs = stats.totalNs.exchange(0, std::memory_order_relaxed);
+      out.maxNs = stats.maxNs.exchange(0, std::memory_order_relaxed);
+      out.ok = stats.ok.exchange(0, std::memory_order_relaxed);
+      out.falseResults = stats.falseResults.exchange(0, std::memory_order_relaxed);
+      out.errors = stats.errors.exchange(0, std::memory_order_relaxed);
+      out.changed = stats.changed.exchange(0, std::memory_order_relaxed);
+      out.flagged = stats.flagged.exchange(0, std::memory_order_relaxed);
+      out.units = stats.units.exchange(0, std::memory_order_relaxed);
+      return out;
+    }
+
+    static std::string TakeStats() {
+      // Relaxed per-counter snapshots may split a concurrent operation across windows.
+      // Interpret rates and large samples, not exact field-by-field transactional identities.
+      std::ostringstream out;
+      out << std::fixed << std::setprecision(3);
+      bool first = true;
+      for (uint32_t i = 0; i < uint32_t(Op::Count); i++) {
+        const Op op = Op(i);
+        const Snapshot s = Take(Stats()[i]);
+        if (!s.calls)
+          continue;
+        if (!first)
+          out << "; ";
+        first = false;
+        out << Name(op) << " n=" << s.calls
+            << " ok=" << s.ok << " false=" << s.falseResults << " errors=" << s.errors
+            << " changed=" << s.changed << " flagged=" << s.flagged << " units=" << s.units
+            << " avg=" << double(s.totalNs) / double(s.calls) / 1.0e6
+            << " max=" << double(s.maxNs) / 1.0e6 << "ms";
+      }
+      return out.str();
+    }
+
+  };
+
+}
+
+#endif
