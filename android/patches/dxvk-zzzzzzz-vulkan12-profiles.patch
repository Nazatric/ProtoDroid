diff --git a/src/dxvk/dxvk_state_cache_io.h b/src/dxvk/dxvk_state_cache_io.h
new file mode 100644
index 0000000..f76e16b
--- /dev/null
+++ b/src/dxvk/dxvk_state_cache_io.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstddef>
+
+namespace dxvk {
+
+  // Keep the cache entry layout and incremental flush in one small, host-testable operation. Android can be killed
+  // without running C++ destructors, so buffering an entry until the next one or until shutdown loses useful work.
+  template<typename Stream, typename Header, typename Hash>
+  void writeStateCacheEntryPayload(Stream& stream, const Header& header, const Hash& hash,
+      const void* data, size_t size) {
+    stream.write(reinterpret_cast<const char*>(&header), sizeof(header));
+    stream.write(reinterpret_cast<const char*>(&hash), sizeof(hash));
+    stream.write(static_cast<const char*>(data), size);
+    stream.flush();
+  }
+
+
+  // A stop request must not discard entries already queued. The writer exits only when both conditions are true.
+  constexpr bool stateCacheWriterShouldStop(bool queueEmpty, bool stopRequested) {
+    return queueEmpty && stopRequested;
+  }
+
+}
