           uint32_t                  numSupported,
     const VkPresentModeKHR*         pSupported,
           uint32_t                  syncInterval) {
+#ifdef __ANDROID__
+    // Android/Mali swapchains have exhibited repeated MAILBOX recreation.
+    // FIFO is mandatory in Vulkan and avoids that path for both sync modes.
+    for (uint32_t i = 0; i < numSupported; i++) {
+      if (pSupported[i] == VK_PRESENT_MODE_FIFO_KHR)
+        return VK_PRESENT_MODE_FIFO_KHR;
