diff --git a/common/os_arch_features.h b/common/os_arch_features.h
index ee0586d..329627c 100644
--- a/common/os_arch_features.h
+++ b/common/os_arch_features.h
@@ -4,2 +4,6 @@
 #include <stddef.h>
+#if defined(ANDROID)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
 #include "pac_kit.h"
@@ -38,6 +42,7 @@ inline void make_memory_readable(void *address, size_t size) {
 #if defined(ANDROID)
-  auto page = (void *)ALIGN_FLOOR(address, OSMemory::PageSize());
-  if (!OSMemory::SetPermission(page, OSMemory::PageSize(), kReadExecute)) {
-    return;
-  }
+  (void)size;
+  const long page_size = sysconf(_SC_PAGESIZE);
+  if (page_size <= 0) return;
+  auto page = (void *)ALIGN_FLOOR(address, page_size);
+  if (mprotect(page, static_cast<size_t>(page_size), PROT_READ | PROT_EXEC) != 0) return;
 #endif
