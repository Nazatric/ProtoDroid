diff --git a/src/d3d9/d3d9_warm_cache_trace.h b/src/d3d9/d3d9_warm_cache_trace.h
new file mode 100644
index 0000000..23a72ca
--- /dev/null
+++ b/src/d3d9/d3d9_warm_cache_trace.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#ifdef __ANDROID__
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+
+#include "../util/util_env.h"
+
+namespace dxvk {
+
+  // Opt-in periodic warm-cache observation. The caller supplies a try-lock snapshot reader: this scheduler never
+  // waits for feeder/pipeline work and never calls the drain. Disabled polls do not read the clock, queue state, or
+  // scheduler atomics. Snapshots are instantaneous samples, not a continuous history or GPU-time measurement.
+  class D3D9WarmCacheTrace {
+  public:
+
+    static constexpr int64_t kIntervalNs = 250000000ll;
+
+    struct State {
+      std::atomic<int64_t> nextLogNs = { 0 };
+    };
+
+    static bool Enabled() {
+      static const bool enabled = env::getEnvVar("PROTODROID_WARM_CACHE_TRACE") == "1";
+      return enabled;
+    }
+
+    static int64_t Now() {
+      return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    static int64_t NextDue(int64_t now) {
+      return now > std::numeric_limits<int64_t>::max() - kIntervalNs
+        ? std::numeric_limits<int64_t>::max() : now + kIntervalNs;
+    }
+
+    template<typename Clock, typename ReadSnapshot, typename Emit>
+    static void MaybeLog(State& state, bool enabled, Clock&& clock,
+                         ReadSnapshot&& readSnapshot, Emit&& emit) {
+      if (!enabled)
+        return;
+      const int64_t now = clock();
+      int64_t next = state.nextLogNs.load(std::memory_order_relaxed);
+      while (now >= next) {
+        if (state.nextLogNs.compare_exchange_weak(next, NextDue(now), std::memory_order_relaxed)) {
+          // Only the thread that claims the due window reads queue state. Other Present calls return immediately.
+          emit(readSnapshot(), now);
+          break;
+        }
+      }
+    }
+
+  };
+
+}
+
+#endif
