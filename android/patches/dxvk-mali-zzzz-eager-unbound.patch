+  void DxvkDevice::initializeUnboundResources() {
+    if (likely(m_features.extRobustness2.nullDescriptor))
+      return;
+
+    // The adapter calls this while it still owns the device reference, before
+    // client API or CS threads can access descriptor state. Submit and finish
+    // the initial transitions now so every cached dummy handle is fully
+    // initialized before its first descriptor write.
+    Rc<DxvkContext> context = createContext();
+    context->beginRecording(createCommandList());
+    m_objects.dummyResources().initialize(context.ptr());
+
+    DxvkSubmitStatus status;
+    submitCommandList(context->endRecording(), &status);
+
+    VkResult result = waitForSubmission(&status);
+    if (result == VK_SUCCESS) {
+      waitForIdle();
+      result = getDeviceStatus();
+    }
+
+    if (result != VK_SUCCESS)
+      throw DxvkError(str::format("DxvkDevice: Failed to initialize dummy resources: ", result));
+
+    Logger::info("DxvkUnboundResources: dummy image GPU initialization complete");
+  }
+
