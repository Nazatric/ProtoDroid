diff --git a/src/dxvk/shaders/dxvk_present_frag_fxaa.frag b/src/dxvk/shaders/dxvk_present_frag_fxaa.frag
new file mode 100644
index 0000000..704d926
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_present_frag_fxaa.frag
@@ -0,0 +1,99 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : enable
+
+#include "dxvk_present_common.glsl"
+
+// ProtoDroid compatibility AA for Prototype's single-sample SDR frame.
+// Luma-directed FXAA follows Timothy Lottes' display-referred, single-pass
+// approach: leave flat regions alone and blend only along detected edges.
+layout(location = 0) in  vec2 i_coord;
+layout(location = 0) out vec4 o_color;
+
+const float FXAA_REDUCE_MIN = 1.0f / 128.0f;
+const float FXAA_REDUCE_MUL = 1.0f / 8.0f;
+const float FXAA_SPAN_MAX   = 8.0f;
+const float FXAA_EDGE_MIN   = 1.0f / 24.0f;
+const float FXAA_EDGE_REL   = 1.0f / 8.0f;
+
+vec4 to_display(vec4 color) {
+  // Sampling an sRGB image returns linear values. FXAA luma and blends must
+  // instead use perceptual/display-referred values. UNORM input is unchanged.
+  if (c_src_is_srgb)
+    color.rgb = linear_to_srgb(color.rgb);
+  return color;
+}
+
+vec4 fetch_display(ivec2 pos) {
+  ivec2 lo = src_offset;
+  ivec2 hi = src_offset + src_extent - 1;
+  return to_display(texelFetch(s_image, clamp(pos, lo, hi), 0));
+}
+
+// Bilinear sample in source-pixel coordinates. Doing this explicitly keeps
+// sRGB interpolation in display space and clamps every tap to srcRect.
+vec4 sample_display(vec2 pos) {
+  vec2 p = pos - 0.5f;
+  ivec2 i = ivec2(floor(p));
+  vec2 f = p - vec2(i);
+
+  vec4 a = mix(fetch_display(i),               fetch_display(i + ivec2(1, 0)), f.x);
+  vec4 b = mix(fetch_display(i + ivec2(0, 1)), fetch_display(i + ivec2(1, 1)), f.x);
+  return mix(a, b, f.y);
+}
+
+float fxaa_luma(vec3 color) {
+  return dot(color, vec3(0.299f, 0.587f, 0.114f));
+}
+
+vec4 display_to_output(vec4 color) {
+  // Return to the source sample domain, then use DXVK's ordinary color-space
+  // conversion. This preserves UNORM/sRGB and source/destination conversions.
+  if (c_src_is_srgb)
+    color.rgb = srgb_to_linear(color.rgb);
+  return sc_rgb_to_output(input_to_sc_rgb(color));
+}
+
+void main() {
+  // The present sampler uses pixel coordinates. i_coord also handles scaled
+  // presents; at 1:1 this is the ordinary texel center.
+  vec2 center = vec2(src_offset) + vec2(src_extent) * i_coord;
+  ivec2 pos = ivec2(floor(center));
+
+  // Preserve the existing linear-filtered center sample and its alpha. Flat
+  // regions take no additional directional samples beyond edge detection.
+  vec4 colorM = to_display(textureLod(s_image, center, 0.0f));
+  float lumaM  = fxaa_luma(colorM.rgb);
+  float lumaNW = fxaa_luma(fetch_display(pos + ivec2(-1, -1)).rgb);
+  float lumaNE = fxaa_luma(fetch_display(pos + ivec2( 1, -1)).rgb);
+  float lumaSW = fxaa_luma(fetch_display(pos + ivec2(-1,  1)).rgb);
+  float lumaSE = fxaa_luma(fetch_display(pos + ivec2( 1,  1)).rgb);
+
+  float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
+  float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));
+
+  if (lumaMax - lumaMin < max(FXAA_EDGE_MIN, lumaMax * FXAA_EDGE_REL)) {
+    o_color = display_to_output(colorM);
+    return;
+  }
+
+  vec2 dir = vec2(
+    -((lumaNW + lumaNE) - (lumaSW + lumaSE)),
+     ((lumaNW + lumaSW) - (lumaNE + lumaSE)));
+
+  float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE)
+    * 0.25f * FXAA_REDUCE_MUL, FXAA_REDUCE_MIN);
+  float rcpDirMin = 1.0f / (min(abs(dir.x), abs(dir.y)) + dirReduce);
+  dir = clamp(dir * rcpDirMin, vec2(-FXAA_SPAN_MAX), vec2(FXAA_SPAN_MAX));
+
+  vec3 rgbA = 0.5f * (
+    sample_display(center + dir * (1.0f / 3.0f - 0.5f)).rgb +
+    sample_display(center + dir * (2.0f / 3.0f - 0.5f)).rgb);
+  vec3 rgbB = rgbA * 0.5f + 0.25f * (
+    sample_display(center - dir * 0.5f).rgb +
+    sample_display(center + dir * 0.5f).rgb);
+
+  float lumaB = fxaa_luma(rgbB);
+  vec3 color = (lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB;
+  o_color = display_to_output(vec4(color, colorM.a));
+}
