+      maliAppendPNext(out, "pNext", state.pNext);
+      out << "\n";
+      for (uint32_t i = 0; i < state.vertexBindingDescriptionCount && state.pVertexBindingDescriptions; i++) {
+        const auto& binding = state.pVertexBindingDescriptions[i];
+        out << "    binding[" << i << "] binding=" << binding.binding
