+    }
+
+    if (info.pViewportState) {
+      const auto& state = *info.pViewportState;
+      out << "  viewport viewports=" << state.viewportCount
+          << " scissors=" << state.scissorCount;
+      maliAppendPNext(out, "pNext", state.pNext);
+      out << "\n";
+    }
+
+    if (info.pRasterizationState) {
+      const auto& state = *info.pRasterizationState;
+      out << "  rasterizer depthClamp=" << state.depthClampEnable
+          << " discard=" << state.rasterizerDiscardEnable
+          << " polygonMode=" << state.polygonMode
+          << " cullMode=0x" << std::hex << state.cullMode
