+          << " specialization=" << (stage.pSpecializationInfo ? "present" : "null")
+          << " spirvBytes=" << spirv.size
+          << " spirvHash=0x" << std::hex << spirv.hash << std::dec
+          << " structurallyValid=" << spirv.structurallyValid
+          << " clipDistance=" << spirv.clipDistance
+          << " cullDistance=" << spirv.cullDistance
+          << " demote=" << spirv.demote
