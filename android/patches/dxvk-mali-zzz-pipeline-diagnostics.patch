+  // Keep pipeline calls serialized at the device-function-table boundary.
+  // Serialization alone did not fix the deterministic Mali fault; the lock
+  // now also keeps each durable trace and shader dump paired with its call.
   static std::mutex                      g_pipelineCompileMutex;
   static PFN_vkCreateGraphicsPipelines   g_createGraphicsPipelines = nullptr;
   static PFN_vkCreateComputePipelines    g_createComputePipelines = nullptr;
 
