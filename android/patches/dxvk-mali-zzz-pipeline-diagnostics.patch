+  static constexpr const char* g_maliTraceFile = "/storage/emulated/0/Prototype/logs/pipeline_trace.log";
+  static std::atomic<uint64_t> g_maliTraceSequence = { 0 };
+
+  struct MaliDescriptorDecorations {
+    uint32_t set = ~0u;
+    uint32_t binding = ~0u;
+  };
+
+  struct MaliSpirvInfo {
+    const uint32_t* code = nullptr;
+    size_t size = 0;
+    uint64_t hash = 0;
+    bool structurallyValid = false;
+    bool clipDistance = false;
+    bool cullDistance = false;
+    bool demote = false;
+    bool kill = false;
+    uint32_t descriptorDuplicates = 0;
+    uint32_t descriptorIncomplete = 0;
+    std::map<uint32_t, MaliDescriptorDecorations> descriptors;
+  };
+
+  static uint64_t maliHandleValue(uint64_t handle) {
+    return handle;
+  }
+
+  template<typename T>
+  static uint64_t maliHandleValue(T* handle) {
+    return reinterpret_cast<uintptr_t>(handle);
+  }
+
+  static void maliEnsureTraceDirectory() {
+    // The Java side normally creates this tree. Keep the native diagnostic
+    // path self-contained as well, and never throw from a driver wrapper.
+    mkdir("/storage/emulated/0/Prototype", 0777);
+    mkdir(g_maliTraceDirectory, 0777);
+  }
+
+  static bool maliWriteSynced(
+    const char* path,
+    const void* data,
+          size_t size,
+          bool append) {
+    int flags = O_WRONLY | O_CREAT | O_CLOEXEC | (append ? O_APPEND : O_TRUNC);
+    int fd = open(path, flags, 0666);
+
+    if (fd < 0)
+      return false;
+
+    const char* bytes = static_cast<const char*>(data);
+    size_t written = 0;
+    bool ok = true;
+
+    while (written < size) {
+      ssize_t result = write(fd, bytes + written, size - written);
+
+      if (result < 0 && errno == EINTR)
+        continue;
+
+      if (result <= 0) {
+        ok = false;
+        break;
+      }
+
+      written += size_t(result);
+    }
+
+    if (fsync(fd) != 0)
+      ok = false;
+    if (close(fd) != 0)
+      ok = false;
+
+    return ok;
+  }
+
+  static void maliSyncTraceDirectory() {
+    int fd = open(g_maliTraceDirectory, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd >= 0) {
+      fsync(fd);
+      close(fd);
+    }
+  }
+
+  static const VkShaderModuleCreateInfo* maliFindModuleInfo(
+    const VkPipelineShaderStageCreateInfo& stage) {
+    auto* base = static_cast<const VkBaseInStructure*>(stage.pNext);
+
+    for (uint32_t depth = 0; base && depth < 16; depth++) {
+      if (base->sType == VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO)
+        return reinterpret_cast<const VkShaderModuleCreateInfo*>(base);
+      base = base->pNext;
+    }
+
+    return nullptr;
+  }
+
+  static MaliSpirvInfo maliAnalyzeSpirv(const VkShaderModuleCreateInfo* moduleInfo) {
+    MaliSpirvInfo result;
+
+    if (!moduleInfo || !moduleInfo->pCode || !moduleInfo->codeSize)
+      return result;
+
+    result.code = moduleInfo->pCode;
+    result.size = moduleInfo->codeSize;
+
+    const uint8_t* bytes = reinterpret_cast<const uint8_t*>(result.code);
+    result.hash = 14695981039346656037ull;
+    for (size_t i = 0; i < result.size; i++)
+      result.hash = (result.hash ^ bytes[i]) * 1099511628211ull;
+
+    if (result.size < 5 * sizeof(uint32_t) || (result.size & 3)
+     || result.code[0] != 0x07230203)
+      return result;
+
+    result.structurallyValid = true;
+    size_t wordCount = result.size / sizeof(uint32_t);
+    std::map<std::pair<uint32_t, uint32_t>, uint32_t> descriptorOwners;
+
+    for (size_t offset = 5; offset < wordCount; ) {
+      uint32_t firstWord = result.code[offset];
+      uint32_t instructionSize = firstWord >> 16;
+      uint32_t opCode = firstWord & 0xffff;
+
+      if (!instructionSize || instructionSize > wordCount - offset) {
+        result.structurallyValid = false;
+        break;
+      }
+
+      const uint32_t* args = result.code + offset + 1;
+      uint32_t argCount = instructionSize - 1;
+
+      if (opCode == spv::OpCapability && argCount >= 1) {
+        result.clipDistance |= args[0] == spv::CapabilityClipDistance;
+        result.cullDistance |= args[0] == spv::CapabilityCullDistance;
+      } else if (opCode == spv::OpDecorate && argCount >= 3) {
+        uint32_t id = args[0];
+
+        if (args[1] == spv::DecorationDescriptorSet)
+          result.descriptors[id].set = args[2];
+        else if (args[1] == spv::DecorationBinding)
+          result.descriptors[id].binding = args[2];
+        else if (args[1] == spv::DecorationBuiltIn) {
+          result.clipDistance |= args[2] == spv::BuiltInClipDistance;
+          result.cullDistance |= args[2] == spv::BuiltInCullDistance;
+        }
+      } else if (opCode == spv::OpMemberDecorate && argCount >= 4) {
+        if (args[2] == spv::DecorationBuiltIn) {
+          result.clipDistance |= args[3] == spv::BuiltInClipDistance;
+          result.cullDistance |= args[3] == spv::BuiltInCullDistance;
+        }
+      } else if (opCode == spv::OpDemoteToHelperInvocation) {
+        result.demote = true;
+      } else if (opCode == spv::OpKill) {
+        result.kill = true;
+      }
+
+      offset += instructionSize;
+    }
+
+    for (const auto& entry : result.descriptors) {
+      uint32_t set = entry.second.set;
+      uint32_t binding = entry.second.binding;
+
+      if (set == ~0u || binding == ~0u) {
+        result.descriptorIncomplete++;
+        continue;
+      }
+
+      auto key = std::make_pair(set, binding);
+      auto owner = descriptorOwners.find(key);
+      if (owner != descriptorOwners.end() && owner->second != entry.first)
+        result.descriptorDuplicates++;
+      else
+        descriptorOwners.insert({ key, entry.first });
+    }
+
+    return result;
+  }
+
+  static void maliAppendPNext(std::ostringstream& out, const char* name, const void* chain) {
+    out << " " << name << "=[";
+    auto* base = static_cast<const VkBaseInStructure*>(chain);
+    uint32_t count = 0;
+
+    while (base && count++ < 16) {
+      if (count > 1)
+        out << ",";
+      out << uint32_t(base->sType);
+      base = base->pNext;
+    }
+
+    if (base)
+      out << ",truncated";
+    out << "]";
+  }
+
+  template<typename T>
+  static void maliAppendHandle(std::ostringstream& out, const char* name, T handle) {
+    out << " " << name << "=0x" << std::hex << maliHandleValue(handle) << std::dec;
+  }
+
+  static bool maliDumpSpirv(const char* fileName, const MaliSpirvInfo& spirv) {
+    std::string path = g_maliTraceDirectory;
+    path += "/";
+    path += fileName;
+    return maliWriteSynced(path.c_str(), spirv.code, spirv.size, false);
+  }
+
+  static void maliTraceGraphicsPipeline(
+    const VkGraphicsPipelineCreateInfo& info,
+          uint64_t sequence,
+          bool dumpShaders) {
+    maliEnsureTraceDirectory();
+
+    std::ostringstream out;
+    out << "MALI_PIPELINE_BEGIN seq=" << sequence
+        << " call=vkCreateGraphicsPipelines";
+    maliAppendHandle(out, "layout", info.layout);
+    maliAppendHandle(out, "basePipeline", info.basePipelineHandle);
+    out << " flags=0x" << std::hex << info.flags << std::dec
+        << " basePipelineIndex=" << info.basePipelineIndex
+        << " stageCount=" << info.stageCount;
+    maliAppendPNext(out, "pNext", info.pNext);
+    out << "\n";
+
+    const VkPipelineRenderingCreateInfo* rendering = nullptr;
+    auto* next = static_cast<const VkBaseInStructure*>(info.pNext);
+    for (uint32_t depth = 0; next && depth < 16; depth++) {
+      if (next->sType == VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO) {
+        rendering = reinterpret_cast<const VkPipelineRenderingCreateInfo*>(next);
+        break;
+      }
+      next = next->pNext;
+    }
+
+    if (rendering) {
+      out << "  rendering viewMask=" << rendering->viewMask
+          << " colorAttachmentCount=" << rendering->colorAttachmentCount
+          << " depthFormat=" << rendering->depthAttachmentFormat
+          << " stencilFormat=" << rendering->stencilAttachmentFormat
+          << " colorFormats=[";
+
+      for (uint32_t i = 0; i < rendering->colorAttachmentCount; i++) {
+        if (i) out << ",";
+        out << (rendering->pColorAttachmentFormats
+          ? rendering->pColorAttachmentFormats[i] : VK_FORMAT_UNDEFINED);
+      }
+
+      if (rendering->colorAttachmentCount && !rendering->pColorAttachmentFormats)
+        out << ";NULL_ARRAY";
+      out << "]";
+      maliAppendPNext(out, "pNext", rendering->pNext);
+      out << "\n";
+    } else {
+      out << "  rendering=absent\n";
+    }
+
+    bool hasVs = false;
+    bool hasFs = false;
+    bool vsDumpOk = false;
+    bool fsDumpOk = false;
+
+    for (uint32_t i = 0; i < info.stageCount && info.pStages; i++) {
+      const auto& stage = info.pStages[i];
+      MaliSpirvInfo spirv = maliAnalyzeSpirv(maliFindModuleInfo(stage));
+
+      if (dumpShaders && stage.stage == VK_SHADER_STAGE_VERTEX_BIT) {
+        hasVs = true;
+        vsDumpOk = maliDumpSpirv("last_vs.spv", spirv);
+      } else if (dumpShaders && stage.stage == VK_SHADER_STAGE_FRAGMENT_BIT) {
+        hasFs = true;
+        fsDumpOk = maliDumpSpirv("last_fs.spv", spirv);
+      }
+
+      out << "  stage[" << i << "] stage=0x" << std::hex << stage.stage
+          << " flags=" << stage.flags << std::dec;
+      maliAppendHandle(out, "module", stage.module);
