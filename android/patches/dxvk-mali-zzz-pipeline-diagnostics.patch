+          << " descriptors=" << spirv.descriptors.size()
+          << " descriptorDuplicates=" << spirv.descriptorDuplicates
+          << " descriptorIncomplete=" << spirv.descriptorIncomplete;
+      maliAppendPNext(out, "pNext", stage.pNext);
+      out << "\n";
+
+      for (const auto& entry : spirv.descriptors) {
